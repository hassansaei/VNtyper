{
  "default_values": {
    "threads": 4,
    "output_dir": "out",
    "output_name": "output",
    "archive_format": "zip",
    "report_file": "summary_report.html",
    "flanking": 50,
    "summary_file": "cohort_summary.html",
    "reference_assembly": "hg19"
  },
  "cli_defaults": {
    "log_level": "INFO",
    "log_file": "pipeline.log"
  },
  "api": {
    "base_url": "https://vntyper.org/api",
    "poll_interval_seconds": 10,
    "poll_timeout_seconds": 14400
  },
  "reference_data": {
    "muc1_reference_vntr": "reference/All_Pairwise_and_Self_Merged_MUC1_motifs_filtered.fa",
    "advntr_reference_vntr_hg19": "reference/vntr_db_advntr_v2/hg19_muc1.db",
    "advntr_reference_vntr_hg38": "reference/vntr_db_advntr_v2/hg38_muc1.db",
    "muc1_region_fasta_hg19": "reference/muc1_region_hg19.fa",
    "muc1_region_fasta_hg38": "reference/muc1_region_hg38.fa",
    "bwa_reference_hg19": "reference/alignment/chr1.hg19.fa",
    "bwa_reference_hg38": "reference/alignment/chr1.hg38.fa",
    "bwa_reference_GRCh37": "reference/alignment/chr1.GRCh37.fna",
    "bwa_reference_GRCh38": "reference/alignment/chr1.GRCh38.fna",
    "bwa_reference_hg19_ensembl": "reference/alignment/chr1.hg19_ensembl.fa",
    "bwa_reference_hg38_ensembl": "reference/alignment/chr1.hg38_ensembl.fa",
    "cram_reference_hg19": null,
    "cram_reference_hg38": null,
    "code_adVNTR_RUs": "reference/code-adVNTR_RUs.fa",
    "muc1_motifs_rev_com": "reference/MUC1_motifs_Rev_com.fa"
  },
  "bam": {
    "unmapped_scan": "auto"
  },
  "cram": {
    "allow_ambient_reference_resolution": false,
    "local_ref_path": "%2s/%2s/%s",
    "reference_probe_timeout_seconds": 120,
    "stream_probe_timeout_seconds": 1800,
    "unmapped_scan": "auto",
    "reference_candidate_order": [
      "cli",
      "config_cram_reference",
      "config_bwa_reference",
      "htslib_resolved"
    ]
  },
  "tools": {
    "fastp": "fastp",
    "samtools": "samtools",
    "bwa": "bwa",
    "advntr": "mamba run -n envadvntr advntr",
    "shark": "mamba run -n shark_env shark",
    "kestrel": "vntyper/dependencies/kestrel/kestrel.jar",
    "_comment_kanalyze": "Declared explicitly rather than derived from the kestrel jar's directory: an operator may legitimately relocate kestrel.jar, and a derived sibling path would then be silently wrong. It has no version flag of its own and is never version-probed - it ships and is versioned with kestrel.",
    "kanalyze": "vntyper/dependencies/kestrel/kanalyze.jar",
    "java_path": "java"
  },
  "tool_params": {
    "bwa_index_extensions": [".amb", ".ann", ".bwt", ".pac", ".sa"]
  },
  "bam_processing": {
    "_comment_vntr_array_coords": "vntr_array_coords is the repeat array itself, without flank, and it differs in length between the builds because the assemblies represent different amounts of it: GRCh37 carries roughly 13.5 60-bp units, GRCh38 roughly 58. For the same sample that makes mean depth over the ARRAY about 4.3x higher on GRCh37 (measured 4.257-4.339 across the seven paired fixtures, against 3481/811 = 4.29 predicted), and mean depth over the wider vntr_region_coords window about 2.7x higher (2.498-2.888) because that window also carries flank, whose depth does not scale with repeat count (#222). Both bounds were derived by ONE procedure applied identically to both assemblies - scanning the region FASTA in 120 bp windows at 30 bp step for GC > 0.65 and 60 bp self-identity > 0.85 - because the array-sum comparison tolerates a symmetric error (moving both outward by 100 bp keeps it within 1.1% of unity) but not a one-sided one (widening GRCh37 alone by 140 bp moves it to 1.175). Re-derive both together or neither. These bounds are heuristic, not an authoritative annotation.",
    "assemblies": {
      "GRCh37": {
        "bam_region_coords": "155158000-155163000",
        "vntr_region_coords": "155160500-155162000",
        "vntr_array_coords": "155161000-155161810",
        "chromosome": 1
      },
      "GRCh38": {
        "bam_region_coords": "155184000-155194000",
        "vntr_region_coords": "155188000-155192500",
        "vntr_array_coords": "155188530-155192010",
        "chromosome": 1
      }
    },
    "known_chromosome_naming": {
      "GRCh37": {
        "ucsc": "chr1",
        "ensembl": "1",
        "ncbi": "NC_000001.10"
      },
      "GRCh38": {
        "ucsc": "chr1",
        "ensembl": "1",
        "ncbi": "NC_000001.11"
      }
    },
    "_comment_legacy_regions": "LEGACY: The hardcoded region strings below are maintained for backward compatibility only. New code should use the dynamic region resolution via reference_registry.py.",
    "bam_region_hg19": "chr1:155158000-155163000",
    "bam_region_hg38": "chr1:155184000-155194000",
    "bam_region_hg19_ensembl": "1:155158000-155163000",
    "bam_region_hg38_ensembl": "1:155184000-155194000",
    "bam_region_hg19_ncbi": "NC_000001.10:155158000-155163000",
    "bam_region_hg38_ncbi": "NC_000001.11:155184000-155194000",
    "bam_region_GRCh37": "NC_000001.10:155158000-155163000",
    "bam_region_GRCh38": "NC_000001.11:155184000-155194000",
    "vntr_region_hg19": "chr1:155160500-155162000",
    "vntr_region_hg38": "chr1:155188000-155192500",
    "vntr_region_hg19_ensembl": "1:155160500-155162000",
    "vntr_region_hg38_ensembl": "1:155188000-155192500",
    "vntr_region_hg19_ncbi": "NC_000001.10:155160500-155162000",
    "vntr_region_hg38_ncbi": "NC_000001.11:155188000-155192500",
    "vntr_region_GRCh37": "NC_000001.10:155160500-155162000",
    "vntr_region_GRCh38": "NC_000001.11:155188000-155192500",
    "compression_level": 6,
    "disable_adapter_trimming": true,
    "deduplication": true,
    "dup_calc_accuracy": 3,
    "length_required": 50,
    "qualified_quality_phred": 20
  },
  "visualization": {
    "donut_colors": ["#56B4E9", "#D55E00", "#999999"],
    "donut_hole_size": 0.6,
    "plot_height": 500,
    "plot_width": 500,
    "annotation_font_size": 14
  },
  "thresholds": {
    "mean_vntr_coverage": 100,
    "percent_vntr_uncovered": 50.0,
    "duplication_rate": 0.1,
    "q20_rate": 0.8,
    "q30_rate": 0.7,
    "passed_filter_reads_rate": 0.8
  },
  "cohort": {
    "kestrel_result_file": "kestrel_result.tsv",
    "advntr_result_file": "output_adVNTR.tsv",
    "pseudonym": {
      "algorithm": "sha256",
      "digest_characters": 12
    }
  },
  "file_processing": {
    "snv_length": 1,
    "kestrel_format": "GT:GDP:DP"
  },
  "install_references": {
    "md5_chunk_size": 4096,
    "checksum_filename": "md5_checksums.txt"
  },
  "paths": {
    "template_dir": "vntyper/templates"
  },
  "utils": {
    "fastq_validation_lines": 4,
    "preflight_text_max_bytes": 1048576
  },
  "cross_match": {
    "match_logic": "Kestrel_Allele_Change == Advntr_Allele_Change and Kestrel_Variant_Type.lower() == Advntr_Variant_Type.lower()"
  },
  "assembly_detection": {
    "detection_threshold": 0.9,
    "naming_convention_threshold": 0.5,
    "primary_contig_patterns": [
      "^chr[0-9XYM]+$",
      "^NC_\\d{6}\\.\\d+$",
      "^([0-9]+|X|Y|MT?)$"
