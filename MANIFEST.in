# Include the main documentation and license
include README.md
include LICENSE

# Include the main config file
include vntyper/config.json

# Include the templates. `_report_base.html` is the shared token layer both of the
# other two `{% include %}`, so a distribution without it renders neither report:
# Jinja2 raises TemplateNotFound at render time, not at import, so nothing that only
# imports the package notices. Every file under vntyper/templates/ has to be named
# here and in pyproject's package-data; tests/unit/test_packaging_consistency.py
# fails on one that is not.
include vntyper/templates/_report_base.html
include vntyper/templates/report_template.html
include vntyper/templates/cohort_summary_template.html

# Include the vendored igv.js and its provenance/licence notice. The report embeds
# the gzip and prints its SHA-256; a distribution without it cannot render an
# alignment browser at all.
include vntyper/assets/igv-3.0.2.min.js.gz
include vntyper/assets/NOTICE.md

# Include all JAR files in the dependencies/kestrel directory
recursive-include vntyper/dependencies/kestrel *.jar

# Include the configuration files in the scripts subpackage
include vntyper/scripts/kestrel_config.json
include vntyper/scripts/install_references_config.json
include vntyper/scripts/report_config.json
include vntyper/scripts/calibration.json

# Include the configuration files for the modules
include vntyper/modules/shark/shark_config.json
include vntyper/modules/advntr/advntr_config.json
