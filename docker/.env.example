# =============================================================================
# VNtyper web service - environment template
# =============================================================================
# Copy to `.env` in this directory before `docker compose up`:
#
#     cp docker/.env.example docker/.env
#
# `.env` is gitignored. Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------
# Password for the Redis instance shared by the API, the Celery worker and beat.
# There is no default: the application reads this variable and refuses to start
# without it, and docker compose refuses to start the stack without it.
#
# Generate a fresh one, for example:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Any characters are accepted - the Redis URL is percent-encoded by the
# application - but a URL-safe value keeps the logs and shell quoting simple.
#
# There is no default and no fallback: the application and `docker compose` both
# refuse to start until this is set. When bringing an existing deployment onto
# this release, generate a new value here rather than carrying one over.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL - defaults shown; see docker/app/config.py
# -----------------------------------------------------------------------------
# REDIS_HOST=redis
# REDIS_PORT=6379

# Total bytes one job submission may upload (default 1 GiB). Also sets the
# ceiling on the whole request, which is this value plus a fixed allowance for
# the multipart framing around the files -- see docker/app/request_limits.py.
# MAX_UPLOAD_BYTES=1073741824

# Refuse new pipeline or cohort submissions while this many unfinished tasks
# already hold reservations in the shared atomic admission registry.
# MAX_QUEUED_JOBS=100

# Free bytes retained on every job volume after aggregate reservations. The
# default is twice the shipped MAX_UPLOAD_BYTES value.
# MIN_FREE_DISK_BYTES=2147483648

# Admission byte values are conservative operational heuristics, not runtime
# quotas or mathematical upper bounds. The pipeline default is three upload
# ceilings: input plus two upload-sized allowances for output, intermediates
# and the optional result archive. Cohorts reserve one upload ceiling of fixed
# report/temp headroom plus two times their aggregate member bytes, covering an
# owned member snapshot and a result archive. Calibrate these for local data.
# PIPELINE_RESERVATION_BYTES=3221225472
# COHORT_RESERVATION_BASE_BYTES=1073741824
# COHORT_MEMBER_RESERVATION_FACTOR=2

# Broker-accepted tasks initially receive a seven-day queued grace. This is a
# deliberately conservative backlog assumption, not a claimed maximum queue
# time and not a task timeout; raise it if intended broker waits can exceed it.
# Running workers renew a one-day lease every five minutes. A killed worker's
# entry is pruned after that lease expires; a healthy long-running worker stays
# reserved through heartbeat renewal.
# ADMISSION_QUEUED_GRACE_SECONDS=604800
# ADMISSION_ACTIVE_LEASE_SECONDS=86400
# ADMISSION_HEARTBEAT_SECONDS=300

# Days a finished job's results are kept before cleanup.
#
# /download/{job_id}/ takes no credential, so this is the exposure window for a
# completed job: the id is the capability. Keep it as short as collection allows.
# MAX_RESULT_AGE_DAYS=3

# Days a cohort is retained.
#
# Clamped to MAX_RESULT_AGE_DAYS at runtime -- a cohort must not stay openable
# after the member archives it lists have been deleted, or /cohort-status/ lists
# job ids whose downloads 404. Setting this higher logs a WARNING and has no
# effect beyond the archive window.
# COHORT_RETENTION_DAYS=3

# Set to `development` or `local` to enable the localhost CORS origins.
# ENVIRONMENT=production

# SMTP, for the optional "email me when the job finishes" feature.
# SMTP_HOST=smtp.hoster.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@hoster.com
